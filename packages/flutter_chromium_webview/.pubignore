# .pubignore replaces .gitignore for `dart pub publish`, so generated/local
# artifacts must be listed here explicitly.

# Unused generated scaffold retained locally, excluded from the package.
example/dummy_plugin/

# Native build artifacts, downloaded CEF distributions and tool state.
# CEF is never shipped: both DownloadCEF.cmake files fetch a pinned,
# SHA-256 verified archive into the CMake binary directory (build/) at build time.
**/build/
**/.dart_tool/
**/.gradle/
**/.kotlin/
**/local.properties
**/gradlew
**/gradlew.bat
**/gradle/wrapper/gradle-wrapper.jar
**/.cxx/
**/GeneratedPluginRegistrant.java
**/key.properties
**/*.keystore
**/*.jks
**/ephemeral/
**/doc/api/
**/__pycache__/
**/*.pyc
**/*.log
**/*.iml
**/.idea/
**/.flutter-plugins-dependencies
**/third_party/
**/cef_download/
**/cef_binary_*

# Monorepo-only local overrides.
pubspec_overrides.yaml

